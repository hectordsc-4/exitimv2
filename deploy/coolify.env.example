# Pegar en Coolify → Application → Environment Variables
# Puerto del contenedor: 8000
# No subas secretos al repo: usa deploy/coolify.env (gitignored).

DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST_INTERNO_COOLIFY:5432/exi_db
BOOTSTRAP_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST_INTERNO_COOLIFY:5432/listaviva
BOOTSTRAP_DB=listaviva
APP_NAME=EXI API
DEBUG=false
CORS_ORIGINS=*
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true
SMTP_SSL=false
